generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PlanType {
  FREE
  PRO
  ENTERPRISE
}

model Organization {
  id               String    @id @default(uuid())
  name             String
  logoPath         String?   @map("logo_path")
  plan             PlanType? @default(FREE)
  billingEmail     String?   @map("billing_email")
  stripeCustomerId String?   @map("stripe_customer_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  projects         Project[]
  members          OrganizationMember[]

  @@map("organizations")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Role {
  ADMIN
  MEMBER
  VIEWER
  OWNER
}

model OrganizationMember {
  id               String       @id @default(uuid())
  userId           String       @map("user_id")
  organizationId   String       @map("organization_id")
  role             Role         @default(MEMBER)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("organization_members")
}

model User {
  id                String          @id @default(uuid())
  email             String          @unique
  password          String
  name              String
  status            UserStatus      @default(ACTIVE)
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  memberships       OrganizationMember[]

  projectsAssigned  Project[]       @relation("ProjectAssignee")
  projectsCreated   Project[]       @relation("ProjectCreator")
  
  ticketsAssigned   Ticket[]        @relation("TicketAssignee")
  ticketsCreated    Ticket[]        @relation("TicketCreator")
  
  ticketComments    TicketComment[]

  @@map("users")
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

model Project {
  id             String        @id @default(uuid())
  name           String
  description    String?
  status         ProjectStatus @default(ACTIVE)
  organizationId String        @map("organization_id")
  createdBy      String?       @map("created_by")
  assigneeId     String?       @map("assignee_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  
  assignee       User?         @relation("ProjectAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator        User?         @relation("ProjectCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  tickets        Ticket[]

  @@index([organizationId])
  @@index([createdBy])
  @@index([assigneeId])
  @@map("projects")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  REVIEW
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Ticket {
  id          String         @id @default(uuid())
  title       String
  description String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  projectId   String         @map("project_id")
  assigneeId  String?        @map("assignee_id")
  createdBy   String         @map("created_by")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  
  assignee    User?          @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator     User           @relation("TicketCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  comments    TicketComment[]

  @@index([projectId])
  @@index([assigneeId])
  @@index([createdBy])
  @@map("tickets")
}

model TicketComment {
  id        String   @id @default(uuid())
  ticketId  String   @map("ticket_id")
  userId    String   @map("user_id")
  comment   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([userId])
  @@map("ticket_comments")
}
