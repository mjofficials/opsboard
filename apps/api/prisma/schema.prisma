generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PlanType {
  FREE
  PRO
  ENTERPRISE
}

model Organization {
  id               String    @id @default(uuid()) @db.Uuid
  name             String
  logoPath         String?   @map("logo_path")
  plan             PlanType? @default(FREE)
  billingEmail     String?   @map("billing_email")
  stripeCustomerId String?   @map("stripe_customer_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  projects Project[]
  members  OrganizationMember[]

  @@index([stripeCustomerId])
  @@map("organizations")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Role {
  ADMIN
  MEMBER
  VIEWER
  OWNER
}

enum MemberStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REJECTED
}

model OrganizationMember {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String?      @map("user_id") @db.Uuid
  email          String
  organizationId String       @map("organization_id") @db.Uuid
  role           Role         @default(MEMBER)
  status         MemberStatus @default(PENDING)
  inviteToken    String?      @unique @map("invite_token")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@unique([email, organizationId])
  @@index([organizationId])
  @@map("organization_members")
}

model User {
  id        String     @id @default(uuid()) @db.Uuid
  email     String     @unique
  password  String
  name      String
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  memberships OrganizationMember[]

  projectsAssigned Project[] @relation("ProjectAssignee")
  projectsCreated  Project[] @relation("ProjectCreator")

  ticketsAssigned Ticket[] @relation("TicketAssignee")
  ticketsCreated  Ticket[] @relation("TicketCreator")

  ticketComments TicketComment[]

  @@map("users")
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

model Project {
  id             String        @id @default(uuid()) @db.Uuid
  name           String
  description    String?
  status         ProjectStatus @default(ACTIVE)
  organizationId String        @map("organization_id") @db.Uuid
  createdBy      String?       @map("created_by") @db.Uuid
  assigneeId     String?       @map("assignee_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  assignee     User?        @relation("ProjectAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator      User?        @relation("ProjectCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  tickets Ticket[]

  @@index([status])
  @@index([organizationId])
  @@index([createdBy])
  @@index([assigneeId])
  @@map("projects")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  REVIEW
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Ticket {
  id          String         @id @default(uuid()) @db.Uuid
  title       String
  description String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  projectId   String         @map("project_id") @db.Uuid
  assigneeId  String?        @map("assignee_id") @db.Uuid
  createdBy   String?        @map("created_by") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  assignee User?           @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator  User?           @relation("TicketCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  project  Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  comments TicketComment[]

  @@index([status])
  @@index([projectId])
  @@index([projectId, status])
  @@index([assigneeId])
  @@index([createdBy])
  @@map("tickets")
}

model TicketComment {
  id        String   @id @default(uuid()) @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  comment   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@index([userId])
  @@map("ticket_comments")
}
